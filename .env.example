# ProxiSpeak Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection (Set your MongoDB URI, or leave empty/fallback to auto-managed memory DB in dev)
MONGODB_URI=mongodb://127.0.0.1:27017/proxispeak
USE_MEMORY_DB=false

# WebRTC ICE Servers Configuration
# Public Google STUN servers (comma-separated)
RTC_STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Optional TURN server for production traversal behind symmetric NATs
RTC_TURN_SERVER=
RTC_TURN_USERNAME=
RTC_TURN_CREDENTIAL=

# Real-Time Spatial Proximity Settings
PROXIMITY_HEARING_RADIUS=120
PROXIMITY_EXIT_GRACE=25
MAX_OFFICE_WIDTH=1600
MAX_OFFICE_HEIGHT=1200
